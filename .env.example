NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Homework photo uploads (/homework/send). Server-only — no NEXT_PUBLIC_ prefix,
# because anything so prefixed is inlined into the browser bundle. Leave it
# unset and the photo field simply reports that uploads are unavailable; every
# other part of the feature keeps working.
IMGBB_API_KEY=your_imgbb_api_key
