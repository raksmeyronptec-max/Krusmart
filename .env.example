NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Cloudflare R2 (image storage) ---------------------------------------
# Every uploaded image — student photos, the four teacher-profile images and
# homework attachments — goes to an R2 bucket through the server actions in
# lib/storage/. R2 is S3-compatible, so these are ordinary S3 credentials
# pointed at https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com.
#
# The first four are server-only — deliberately NOT prefixed NEXT_PUBLIC_,
# because anything so prefixed is inlined into the browser bundle, and an
# access key in the bundle is a write handle on the bucket for anyone who
# opens devtools. Leave them unset and every upload reports a failure; the
# rest of each feature keeps working.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# The public read-only CDN host for the bucket. This one IS public: it is what
# gets stored in `students.photo_url`, `settings.school_logo`, … and rendered
# in an <img src>. No trailing slash needed.
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
